// Overlay rocks for snowy rocks
template template_overlay_rocks(z) {
    template_groundtiles(0, 0, z)
    template_groundtiles(0, 48, z)
    template_groundtiles(0, 96, z)
    template_groundtiles(0, 144, z)
    template_groundtiles(0, 192, z)
}
replacenew overlay_rocks(OVERLAY_ROCKS, "../graphics/terrain/64/general_rockoverlay_alt_snowtransition_8bpp.png", 0) { template_overlay_rocks(1) }
#ez alternative_sprites(overlay_rocks, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "../graphics/terrain/256/general_rockoverlay_alt_snowtransition_8bpp.png") { template_overlay_rocks(4) }
#32 alternative_sprites(overlay_rocks, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "../graphics/terrain/64/general_rockoverlay_alt_snowtransition_bt32bpp.png") { template_overlay_rocks(1) }
#32 #ez alternative_sprites(overlay_rocks, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "../graphics/terrain/256/general_rockoverlay_alt_snowtransition_bt32bpp.png") { template_overlay_rocks(4) }

// Overlay rocks for toyland (unused, but provided for completeness)
template template_overlay_rocks_toyland(z) {
    template_groundtiles(0, 0, z)
    template_groundtiles(0, 0, z)
    template_groundtiles(0, 0, z)
    template_groundtiles(0, 0, z)
    template_groundtiles(0, 0, z)
}
if (climate == CLIMATE_TOYLAND) {
    replacenew overlay_rocks_toyland(OVERLAY_ROCKS, "../graphics/terrain/64/toyland_rockoverlay_8bpp.png", 0) { template_overlay_rocks_toyland(1) }
    #ez alternative_sprites(overlay_rocks_toyland, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "../graphics/terrain/256/toyland_rockoverlay_8bpp.png") { template_overlay_rocks_toyland(4) }
    #32 alternative_sprites(overlay_rocks_toyland, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "../graphics/terrain/64/toyland_rockoverlay_bt32bpp.png") { template_overlay_rocks_toyland(1) }
    #32 #ez alternative_sprites(overlay_rocks_toyland, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "../graphics/terrain/256/toyland_rockoverlay_bt32bpp.png") { template_overlay_rocks_toyland(4) }
}

template template_overlay_rocks_coast(z) {
    template_groundtiles(0, 0, z)
}

// Overlay rocks for coasts
replacenew overlay_rocks_coast(OVERLAY_ROCKS, "../graphics/terrain/64/general_rockoverlay_coasts_alt_8bpp.png", 95) { template_overlay_rocks_coast(1) }
#ez alternative_sprites(overlay_rocks_coast, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "../graphics/terrain/256/general_rockoverlay_coasts_alt_8bpp.png") { template_overlay_rocks_coast(4) }
#32 alternative_sprites(overlay_rocks_coast, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "../graphics/terrain/64/general_rockoverlay_coasts_alt_bt32bpp.png") { template_overlay_rocks_coast(1) }
#32 #ez alternative_sprites(overlay_rocks_coast, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "../graphics/terrain/256/general_rockoverlay_coasts_alt_bt32bpp.png") { template_overlay_rocks_coast(4) }

// Overlay rocks for toyland coasts
if (climate == CLIMATE_TOYLAND) {
    replacenew overlay_rocks_toyland_coast(OVERLAY_ROCKS, "../graphics/terrain/64/toyland_rockoverlay_coasts_8bpp.png", 95) { template_overlay_rocks_coast(1) }
    #ez alternative_sprites(overlay_rocks_toyland_coast, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "../graphics/terrain/256/toyland_rockoverlay_coasts_8bpp.png") { template_overlay_rocks_coast(4) }
    #32 alternative_sprites(overlay_rocks_toyland_coast, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "../graphics/terrain/64/toyland_rockoverlay_coasts_bt32bpp.png") { template_overlay_rocks_coast(1) }
    #32 #ez alternative_sprites(overlay_rocks_toyland_coast, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "../graphics/terrain/256/toyland_rockoverlay_coasts_bt32bpp.png") { template_overlay_rocks_coast(4) }
}
