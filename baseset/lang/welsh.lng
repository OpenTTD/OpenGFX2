STR_GRF_NAME                          :OpenGFX2Base
STR_GRF_DESCRIPTION                   :{ORANGE}Set Graffigau Sylfaenol OpenGFX2{BLACK}{}Gan Zephyris, trwy sefyll ar ysgwyddau'r tîm OpenGFX{}{BLACK}Trwydded: {SILVER}GPL v2+{}{BLACK}Gwefan: {SILVER}https://github.com/OpenTTD/OpenGFX2
